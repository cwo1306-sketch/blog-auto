# 네이버 개발자센터 검색 API 키 (keys.txt의 [Naver-cardnews])
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 선택: Claude Haiku 판정 (keys.txt의 [Anthropic-jachi]). 비우면 두 판정 모두 생략
#   - 경계 구간(0.2~0.4) "같은 사건인가?"       NAVER_CARDNEWS_JUDGE=on|off
#   - 규칙 필터 통과 기사 "니치에 적합한가?"      NAVER_CARDNEWS_NICHE_JUDGE=on|off
ANTHROPIC_API_KEY=
# 선택: 경로·파라미터
NAVER_CARDNEWS_DB=data/news.db
NAVER_CARDNEWS_OUT=data/news_queue.xlsx
NAVER_CARDNEWS_JUDGE=on
NAVER_CARDNEWS_NICHE_JUDGE=on
